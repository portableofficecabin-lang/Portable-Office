merchant-feed.xml

# TypeScript incremental build cache ("incremental": true in tsconfig.json).
# Regenerated by every `tsc`/`next build`, so it was permanently dirty in `git status`
# and every commit carried a meaningless diff. It was already TRACKED, so a .gitignore
# rule alone would not have helped — it is untracked with `git rm --cached` in the same
# commit that adds this line. The file itself stays on disk.
*.tsbuildinfo
